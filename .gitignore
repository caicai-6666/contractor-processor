# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
.venv/
venv/

# Local configuration and runtime data
.env
data/certs/*
data/input/*
!data/input/.gitkeep
data/runs/*
!data/runs/.gitkeep
data/artifacts/*
!data/artifacts/.gitkeep
data/stores/*
!data/stores/.gitkeep
data/logs/*
!data/logs/.gitkeep
data/contracts/*
!data/contracts/.gitkeep

# Exploratory demo outputs
experiments/outputs/*
!experiments/outputs/.gitkeep

# 本地测试与历史实验仅保留在工作区，不进入版本库。
/tests/
/experiments/*/
!/experiments/field_discovery_batch_report/
!/experiments/field_discovery_batch_report/*.py
!/experiments/field_discovery_batch_report/*.md
!/experiments/field_discovery_batch_report/*.yaml
!/experiments/contract_vector_retrieval/
